# The app bundle declares LSMinimumSystemVersion 11.0 (Big Sur = darwin 20).
pre-fetch {
    if {${os.platform} eq "darwin" && ${os.major} < 20} {
        ui_error "${name} requires macOS 11 (Big Sur) or later."
        return -code error "incompatible macOS version"
    }
}

# The cargo group enables +universal by default; the post-build bundling below
# uses one target directory, so build for the native architecture only.
universal_variant   no

# Only the GUI crate; grimalkin-launcher (the Windows console launcher) is not
# needed on macOS. --locked makes cargo fail instead of touching Cargo.lock.
build.args          -p grimalkin --locked

set app_name        grimalkin.app
set app_dir         ${applications_dir}/${app_name}
set app_bindir      ${app_dir}/Contents/MacOS
set target_dir      target/[cargo.rust_platform]/release

# scripts/make-app-bundle.sh --binary wraps the built executable into
# dist/grimalkin.app (Info.plist, icon) and ad-hoc signs it. --no-dmg and
# --no-notarize keep it local; an ad-hoc signature is what the arm64 kernel needs
# to run it, and a MacPorts-built app is never quarantined.
post-build {
    system -W ${worksrcpath} "GRIMALKIN_SIGN_IDENTITY=- scripts/make-app-bundle.sh \
        --binary ${target_dir}/${name} --no-dmg --no-notarize"
}

destroot {
    xinstall -d ${destroot}${applications_dir}
    copy ${worksrcpath}/dist/${app_name} ${destroot}${applications_dir}

    xinstall -d ${destroot}${prefix}/bin
    ln -s ${app_bindir}/${name} ${destroot}${prefix}/bin/${name}

    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} README.md LICENSE LICENSE-MIT LICENSE-APACHE \
        ${destroot}${prefix}/share/doc/${name}
}

# `grimalkin --list-themes` prints the built-in themes and exits without
# opening a window or touching the GPU.
test.run            yes
default test.cmd    {${worksrcpath}/${target_dir}/${name}}
test.target         {}
test.args           --list-themes
test.pre_args       {}

github.livecheck.regex  {([0-9.]+)}

